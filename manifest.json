{
  "manifest_version": 3,
  "name": "E360-Premium",
  "version": "1.0",
  "description": "Làm vì đam mê - Ai thuê thì làm",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://e360.poly.edu.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_start"
    }
  ]
}